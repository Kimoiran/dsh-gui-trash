{
  "name": "dsh-gui-trash",
  "version": "0.1.1",
  "description": "Desktop (Electron) GUI daemon for DeepSeek Harness: a Cordis host plugin plus a command-line launcher wrapping the existing dsh web UI.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "gui",
    "electron"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-gui-trash": "bin/dsh-gui-trash.js"
  },
  "files": [
    "lib",
    "bin",
    "electron",
    "cordis.patch.yml",
    "image",
    "README.md"
  ],
  "scripts": {
    "dsh-gui-trash": "electron electron/",
    "start": "electron electron/",
    "prebuild:exe": "node -e \"const fs=require('fs');for(const p of ['dist/win-unpacked','dist/win-unpacked.tmp','dist/dsh-gui-trash.exe'])try{fs.rmSync(p,{recursive:true,force:true})}catch(e){}\"",
    "build:exe": "electron-builder"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "electron": "^43.4.0"
  },
  "devDependencies": {
    "electron-builder": "^26.15.3"
  }
}
